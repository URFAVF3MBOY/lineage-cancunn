DEVICE_PATH := device/motorola/cancunn

# ---------------------------------------------------------------------------
# Values marked [CONFIRMED] come from your phone (lpdump / getprop / dd).
# Anything marked TODO(verify) still needs checking against your dump.
# ---------------------------------------------------------------------------

BUILD_BROKEN_DUP_RULES := true

# Platform [CONFIRMED]
TARGET_BOARD_PLATFORM := mt6855
TARGET_BOOTLOADER_BOARD_NAME := cancunn
TARGET_NO_BOOTLOADER := true
TARGET_NO_RADIOIMAGE := true

# Architecture [CONFIRMED abilist: arm64-v8a,armeabi-v7a,armeabi]
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv8-2a
TARGET_CPU_ABI := arm64-v8a
TARGET_CPU_VARIANT := generic
TARGET_CPU_VARIANT_RUNTIME := cortex-a55

TARGET_2ND_ARCH := arm
TARGET_2ND_ARCH_VARIANT := armv8-2a
TARGET_2ND_CPU_ABI := armeabi-v7a
TARGET_2ND_CPU_ABI2 := armeabi
TARGET_2ND_CPU_VARIANT := generic
TARGET_2ND_CPU_VARIANT_RUNTIME := cortex-a55

# A/B + Virtual A/B [CONFIRMED: ro.virtual_ab.enabled=true, lpdump flag virtual_ab_device]
AB_OTA_UPDATER := true
AB_OTA_PARTITIONS := \
    boot \
    vendor_boot \
    dtbo \
    vbmeta \
    vbmeta_system \
    system \
    system_ext \
    product \
    vendor \
    vendor_dlkm
TARGET_NO_RECOVERY := true

# Kernel: stock GKI 5.10.240 (android12-5.10, commit 25161a557b20) [CONFIRMED]
# Image.gz / dtb.img were extracted from your boot_a / vendor_boot_a dumps.
# NOTE: your boot_a is KernelSU-patched (kernelsu.ko + ksuinit in the ramdisk), so it is
# NOT used as a prebuilt boot.img. Only its unpatched kernel is used.
TARGET_NO_KERNEL := false
TARGET_PREBUILT_KERNEL := $(DEVICE_PATH)/prebuilts/Image.gz
BOARD_KERNEL_IMAGE_NAME := Image.gz
TARGET_PREBUILT_DTB := $(DEVICE_PATH)/prebuilts/dtb.img
BOARD_INCLUDE_DTB_IN_BOOTIMG := true
BOARD_PREBUILT_DTBOIMAGE := $(DEVICE_PATH)/prebuilts/dtbo.img

# Boot image layout [CONFIRMED from headers]
BOARD_BOOT_HEADER_VERSION := 4
BOARD_KERNEL_PAGESIZE := 4096
BOARD_KERNEL_BASE := 0x3fff8000
BOARD_KERNEL_OFFSET := 0x00008000
BOARD_RAMDISK_OFFSET := 0x26f08000
BOARD_KERNEL_TAGS_OFFSET := 0x07c88000
BOARD_DTB_OFFSET := 0x01f00000
BOARD_RAMDISK_USE_LZ4 := true
BOARD_KERNEL_CMDLINE := bootopt=64S3,32N2,64N2
# TODO(verify): your vendor_boot cmdline also had "loglevel=4 initcall_debug=0 buildvariant=eng"
# (probably from TWRP; stock is likely buildvariant=user)
BOARD_MOVE_RECOVERY_RESOURCES_TO_VENDOR_BOOT := true
BOARD_EXCLUDE_KERNEL_FROM_RECOVERY_IMAGE := true

# Vendor ramdisk modules (196 stock .ko files, load order from stock modules.load)
BOARD_VENDOR_RAMDISK_KERNEL_MODULES := $(wildcard $(DEVICE_PATH)/prebuilts/modules/*.ko)
BOARD_VENDOR_RAMDISK_KERNEL_MODULES_LOAD := $(strip $(shell cat $(DEVICE_PATH)/prebuilts/modules/modules.load))
BOARD_VENDOR_RAMDISK_RECOVERY_KERNEL_MODULES_LOAD := $(strip $(shell cat $(DEVICE_PATH)/prebuilts/modules/modules.load.recovery))

# Physical partition sizes [CONFIRMED from dd dumps]
BOARD_BOOTIMAGE_PARTITION_SIZE := 67108864
BOARD_VENDOR_BOOTIMAGE_PARTITION_SIZE := 67108864
BOARD_DTBOIMG_PARTITION_SIZE := 8388608

# Dynamic partitions [CONFIRMED from lpdump]
# Stock group is "main" (main_a / main_b). There is NO odm partition.
BOARD_SUPER_PARTITION_SIZE := 7180648448
BOARD_SUPER_PARTITION_GROUPS := main
BOARD_MAIN_SIZE := 7178551296
BOARD_MAIN_PARTITION_LIST := system system_ext product vendor vendor_dlkm

# Filesystems [CONFIRMED: mount output + stock fstab, all erofs]
BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_SYSTEM_EXTIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_PRODUCTIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_VENDOR_DLKMIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_USES_VENDOR_DLKMIMAGE := true
TARGET_COPY_OUT_VENDOR := vendor
TARGET_COPY_OUT_VENDOR_DLKM := vendor_dlkm
TARGET_COPY_OUT_PRODUCT := product
TARGET_COPY_OUT_SYSTEM_EXT := system_ext

# Verified boot disabled (matches your unlocked, vbmeta-disabled phone)
BOARD_AVB_ENABLE := false

# Vendor board config (generated by setup-makefiles.sh)
-include vendor/motorola/cancunn/BoardConfigVendor.mk
